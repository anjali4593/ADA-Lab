#include <stdio.h>
#include <stdbool.h>

// Function to print the board configuration
void printSolution(int N, int board[N][N]) {
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            printf("%c ", board[i][j] ? 'Q' : '.');
        }
        printf("\n");
    }
    printf("\n");
}

// Check if placing a queen at board[row][col] is safe
bool isSafe(int N, int board[N][N], int row, int col) {
    // Check this column on upper rows
    for (int i = 0; i < row; i++)
        if (board[i][col])
            return false;

    // Check upper left diagonal
    for (int i = row, j = col; i >= 0 && j >= 0; i--, j--)
        if (board[i][j])
            return false;

    // Check upper right diagonal
    for (int i = row, j = col; i >= 0 && j < N; i--, j++)
        if (board[i][j])
            return false;

    return true;
}

// Recursive function to solve N-Queens
bool solveNQueens(int N, int board[N][N], int row) {
    if (row == N) {
        printSolution(N, board);
        return true;
    }

    bool res = false;
    for (int col = 0; col < N; col++) {
        if (isSafe(N, board, row, col)) {
            board[row][col] = 1;  // Place queen
            res = solveNQueens(N, board, row + 1) || res;
            board[row][col] = 0;  // Backtrack
        }
    }
    return res;
}

int main() {
    int N;
    printf("Enter the size of the board (N): ");
    scanf("%d", &N);

    int board[N][N];
    for (int i = 0; i < N; i++)
        for (int j = 0; j < N; j++)
            board[i][j] = 0;

    if (!solveNQueens(N, board, 0))
        printf("No solution exists for N = %d\n", N);

    return 0;
}
